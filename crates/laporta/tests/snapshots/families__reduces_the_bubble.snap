---
source: crates/laporta/tests/bubble.rs
expression: "bubble.render(&plan, &coefficients)"
---
I(2,1) = (d - 2) / (2*s*m2 - 8*m2^2) * I(1,0)
    + (-d + 3) / (s - 4*m2) * I(1,1)
I(2,2) = (-2*d^2*m2 + d*s + 10*d*m2 - 2*s - 12*m2) / (s^3*m2 - 8*s^2*m2^2 + 16*s*m2^3) * I(1,0)
    + (d^2*s - 9*d*s + 4*d*m2 + 18*s - 12*m2) / (s^3 - 8*s^2*m2 + 16*s*m2^2) * I(1,1)
I(3,1) = (d^2*s^2 - 8*d^2*s*m2 + 8*d^2*m2^2 - 6*d*s^2 + 48*d*s*m2 - 40*d*m2^2 + 8*s^2 - 64*s*m2 + 48*m2^2) / (8*s^3*m2^2 - 64*s^2*m2^3 + 128*s*m2^4) * I(1,0)
    + (d^2*s - 7*d*s - 4*d*m2 + 12*s + 12*m2) / (2*s^3 - 16*s^2*m2 + 32*s*m2^2) * I(1,1)
I(3,0) = (d^2 - 6*d + 8) / (8*m2^2) * I(1,0)
I(1,-1) = (s) * I(1,0)
