source: crates/laporta/tests/families.rs
expression: "reduce(&families::one_loop_box().system(2, 2), &targets)"
---
I(2,1,1,1) = (4*d^2 - 32*d + 60) / (d*s*t^2 - 6*s*t^2) * I(0,1,0,1)
    + (-d + 5) / (s) * I(1,1,1,1)
I(2,2,1,1) = (-4*d^2 + 32*d - 60) / (s^3*t) * I(1,0,1,0)
    + (-4*d^2 + 32*d - 60) / (s*t^3) * I(0,1,0,1)
    + (d^2 - 11*d + 30) / (s*t) * I(1,1,1,1)
I(1,1,2,1) = (4*d^2 - 32*d + 60) / (d*s*t^2 - 6*s*t^2) * I(0,1,0,1)
    + (-d + 5) / (s) * I(1,1,1,1)
I(2,1,1,0) = (2*d - 6) / (s^2) * I(1,0,1,0)
